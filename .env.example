# Public Supabase configuration safe for browser usage.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only Supabase credentials for future trusted backend operations.
# Never expose this value to client code and never use it as a fallback.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
